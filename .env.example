# Server
PORT=5001
NODE_ENV=production
# Required in production/Vercel so sessions persist across serverless cold starts
SESSION_SECRET=replace-with-a-long-random-secret
# Public base URL (e.g. https://your-app.vercel.app) used for OAuth callbacks
APP_URL=
# Set to "false" to disable the demo fallback password ("demo")
DEMO_MODE=true
# Comma-separated list of allowed browser origins (leave empty for same-origin only deployments)
CORS_ORIGIN=

# Database — MongoDB Atlas (leave empty locally to use server/data/store.json)
MONGODB_URI=
MONGODB_DB=ample_lms

# Cloud Media (Cloudinary — for course thumbnails, avatars & lesson videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth 2.0 (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ample LMS
